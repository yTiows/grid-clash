# =============================================================================
# Grid Clash — environment variables
# See SETUP.md for exactly where to get each value and how it's used.
# =============================================================================

# --- Supabase (Settings > API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GAME_API_URL=ws://localhost:3001

# --- WebSocket match server (npm run ws-server) ---
# Long, random secret. Must be IDENTICAL between the Next.js app (issues
# tickets) and the WS server process (verifies them). Generate with:
#   openssl rand -hex 32
WS_TICKET_SECRET=
WS_SERVER_PORT=3001
ALLOWED_ORIGINS=http://localhost:3000

# --- Stripe (dashboard.stripe.com > Developers > API keys) ---
STRIPE_SECRET_KEY=
# dashboard.stripe.com > Developers > Webhooks > your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=
# dashboard.stripe.com > Developers > API keys (safe to expose to the client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Twilio (console.twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# console.twilio.com > Verify > Services > your service > Service SID
TWILIO_VERIFY_SERVICE_SID=
